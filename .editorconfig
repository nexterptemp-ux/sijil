root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Frappe convention: tabs for Python, JS and JSON
[*.{py,js,json,css,html}]
indent_style = tab
indent_size = 4

[*.{ts,tsx}]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
